# Copy this file to .env for local (non-Docker) development.
# When running via `docker compose up`, these are set in docker-compose.yml
# instead, and this file is not read.

POSTGRES_URL=postgresql://atlas:atlas@localhost:5432/atlas
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atlaspassword
